+       clock_timestamp(),
+       json_build_object('tenantId', :'tenant_id', 'rootPlatform', true)::text,
+       :'tenant_id',
+       true
+  FROM tenants tenant
+ WHERE tenant.id = :'tenant_id'::uuid
+   AND NOT EXISTS (
+        SELECT 1 FROM "organization"
+         WHERE "tenantId" = :'tenant_id' AND "rootPlatform" = true
