+        <div className="national-identity-endpoints seller-upload-wide">
+          <label htmlFor="wechat-login-authorize"><span>授权地址</span><Input id="wechat-login-authorize" value={authorizationUrl} disabled={!canEdit || loading} onChange={(event) => setAuthorizationUrl(event.target.value)} inputMode="url" placeholder={DEFAULT_AUTHORIZATION_URL} /></label>
